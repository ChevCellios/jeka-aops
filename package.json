    "expo-asset": "~58.0.3",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.5",
    "expo-constants": "~58.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~58.0.4",
    "expo-location": "~58.0.3",
    "expo-sharing": "~58.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "expo-video-thumbnails": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-audio-api": "0.13.3",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.32.0",
